# Set these in Vercel: Project > Settings > Environment Variables

# Callers must send header: x-api-key: <API_KEY>
API_KEY=change-me-to-a-long-random-string

# ID from the folder URL: https://drive.google.com/drive/folders/<THIS_PART>
GOOGLE_DRIVE_FOLDER_ID=

# --- Auth option A: service account ---
# Paste the whole key JSON (or its base64). The folder must be in a Shared Drive
# (service accounts have no My Drive storage quota), with the service account
# email added as Content Manager.
GOOGLE_SERVICE_ACCOUNT_KEY=

# --- Auth option B: OAuth user (use for a normal "My Drive" folder) ---
# If GOOGLE_REFRESH_TOKEN is set, it takes precedence over option A.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
